# ==========================================
# SkillSwap Environment Configuration Example
# Copy this file to .env and provide your TiDB Cloud credentials
# ==========================================

# Database Configuration (TiDB Cloud MySQL protocol)
# Example TiDB Cloud URL: jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/skillswap?sslMode=VERIFY_IDENTITY
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=skillswap
DB_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/skillswap?sslMode=VERIFY_IDENTITY&useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_tidb_username.root
DB_PASSWORD=your_tidb_password

# Security & Authentication
JWT_SECRET=SkillSwapSuperSecureKeyReplaceInProductionWith32BytesLongSecret2026!
JWT_EXPIRATION_MS=86400000

# Server & CORS
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite Environment Variable (in frontend/.env)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=http://localhost:8080/ws
